{
  "expo": {
    "name": "Medidas Finais",
    "slug": "medidas-finais-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.medidasfinais.preview",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-sqlite",
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "Permitir acesso às fotos para anexá-las aos projetos de medidas.",
          "cameraPermission": "Permitir o uso da câmera para fotografar os ambientes medidos."
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "e2ac97ca-0ba5-4c1b-a69a-3b602cd5c85a"
      }
    },
    "owner": "tiagobraga.comercial"
  }
}
